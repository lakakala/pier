{
  "name": "pier-controller-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-style-nonce.mjs",
    "format": "prettier --write src scripts tests *.ts *.json index.html",
    "format:check": "prettier --check src scripts tests *.ts *.json index.html",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:check": "node scripts/check-build.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.6.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
